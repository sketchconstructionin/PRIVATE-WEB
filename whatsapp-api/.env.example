# Express API Server Port
PORT=5000

# Supabase Credentials (Required for saving leads and logging conversation history)
# Copy these from: https://supabase.com/dashboard/project/swaqwlilafdebynpnihq/settings/api
SUPABASE_URL=https://swaqwlilafdebynpnihq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Meta Developer & WhatsApp API Configuration
# Get these from: https://developers.facebook.com/apps/
META_ACCESS_TOKEN=YOUR_META_WHATSAPP_GRAPH_API_ACCESS_TOKEN
META_PHONE_NUMBER_ID=YOUR_META_WHATSAPP_PHONE_NUMBER_ID

# Custom Webhook Verification Token (Any random string you define)
# Enter this same string in the Meta App Webhook Setup page to verify this server.
META_VERIFY_TOKEN=sketch_verification_token_123

# Business Owner Contact (Your WhatsApp Business number to receive lead notifications)
# Format: Country code without leading '+' (e.g., 918349886687 for India)
BUSINESS_OWNER_NUMBER=918349886687
